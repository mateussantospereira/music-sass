# =============================================================================
# Variaveis de ambiente do log-service (o docker-compose.yml ja define estas)
# Copie para .env e preencha apenas se for rodar o servico FORA do compose:
#   cp .env.example .env
# =============================================================================

# Porta DENTRO do container. Nao e publicada para o host — o log-service so
# existe dentro da rede interna do Docker, igual ao auth-service.
PORT=3000

# Redis. O nome `redis` so resolve de dentro da rede interna do compose.
REDIS_URL=redis://redis:6379

# Chave da Redis Stream. Um stream so para todos os servicos: separar por
# servico faria a pergunta "o que aconteceu no sistema?" virar N leituras.
REDIS_STREAM=auditoria:eventos

# Teto aproximado de entradas no stream (XADD `MAXLEN ~`). Sem teto o stream
# cresce ate o disco do servidor encher — log e a coisa que ninguem lembra de
# limitar.
REDIS_STREAM_MAXLEN=50000

# Quanto tempo esperar pelo Redis antes de desistir (ms).
REDIS_TIMEOUT_MS=2000

# Onde perguntar "esse token pode ler logs?". O log-service NAO tem
# JWT_SECRET: ele nao valida token, consulta o dono da identidade.
AUTH_SERVICE_URL=http://auth-service:3000
AUTH_SERVICE_TIMEOUT_MS=5000

# Permissao exigida para ler o stream. Precisa existir no mapa de permissoes
# do auth-service (auth-service/src/auth/permissoes.ts).
PERMISSAO_LEITURA=consultar:logs

# Segredo compartilhado para ESCREVER eventos (header X-Log-Token).
# Vazio = so a rede interna protege a escrita. Definido = precisa ser o MESMO
# valor no app e no auth-service, senao os eventos deles sao recusados.
LOG_INGEST_TOKEN=
